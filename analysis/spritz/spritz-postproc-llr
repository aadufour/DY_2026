#!/bin/bash
# spritz-postproc-llr: run `spritz-postproc` as one condor job on LLR T3
# (on the login node it spawns 10 workers of 15-46 GB each and gets OOM-killed).
# Needs spritz with the --cpus option (PR fstaeg/spritz#6); the output is histos.pkl.
# should_transfer_files must be YES: with NO, condor requires the worker FileSystemDomain to equal the
# login node one, which no LLR worker matches (job idles forever). Inputs/outputs are on /grid_mnt anyway.
# Usage: run OUTSIDE apptainer, from the config dir (e.g. configs/propcorr_new),
#        after the final merge (condor/results_merged_new.pkl exists).
#   spritz-postproc-llr [request_memory_MB] [cpus]     defaults: 100000 1
# Output: written by spritz-postproc in the config dir (histos etc.), log in postproc_job/.

set -e

MEM=${1:-100000}
CPUS=${2:-1}
CONFIG_DIR=$(pwd)
G=/grid_mnt/data__data.polcms/cms/adufour/spritz_giacomo
SIF=/grid_mnt/data__data.polcms/cms/adufour/spritz-env.sif
ENV=/home/llr/cms/adufour/.conda/envs/spritz

[ -f condor/results_merged_new.pkl ] || { echo "No condor/results_merged_new.pkl here: run from the config dir after the final merge"; exit 1; }

mkdir -p postproc_job
cat > postproc_job/run.sh << EOF
#!/bin/bash
cd ${CONFIG_DIR}
time apptainer exec -B /cvmfs -B /grid_mnt \\
    --env SPRITZ_PATH=${G} --env PYTHONPATH=${G}/src:${G} \\
    ${SIF} \\
    ${ENV}/bin/python ${ENV}/bin/spritz-postproc --cpus ${CPUS}
EOF
chmod +x postproc_job/run.sh

cat > postproc_job/submit.jdl << EOF
universe = vanilla
executable = ${CONFIG_DIR}/postproc_job/run.sh
should_transfer_files = YES
output = ${CONFIG_DIR}/postproc_job/out.txt
error  = ${CONFIG_DIR}/postproc_job/err.txt
log    = ${CONFIG_DIR}/postproc_job/log.txt
request_memory = ${MEM}
request_cpus = ${CPUS}
T3Queue = long
WNTag   = el9
include : /opt/exp_soft/cms/t3/t3queue |
queue 1
EOF

echo "Wrote postproc_job/run.sh and postproc_job/submit.jdl (memory ${MEM} MB, ${CPUS} cpus, long queue)"
condor_submit postproc_job/submit.jdl
