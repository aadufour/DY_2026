#!/bin/bash
# spritz-merge-final-llr: run the final `spritz-merge --merge` as one condor job on LLR T3
# (instead of on the login node: it needs ~50-100 GB RAM with 27 EFT operators).
# Usage: run OUTSIDE apptainer, from the config dir (e.g. configs/propcorr_new),
#        after all `spritz-merge --condor` jobs (merge_condor/) are done.
#   spritz-merge-final-llr [request_memory_MB] [cpus]     defaults: 100000 2
# Output: results_merged_new.pkl in the config dir, written directly on /grid_mnt.

set -e

MEM=${1:-100000}
CPUS=${2:-2}
CONFIG_DIR=$(pwd)
G=/grid_mnt/data__data.polcms/cms/adufour/spritz_giacomo
SIF=/grid_mnt/data__data.polcms/cms/adufour/spritz-env.sif
PY=/home/llr/cms/adufour/.conda/envs/spritz/bin/python

[ -d merge_condor ] || { echo "No merge_condor/ here: run from the config dir after spritz-merge --condor"; exit 1; }

# merge.py has a hardcoded worker count: set it to CPUS (backup kept once)
MERGE_PY=$G/src/spritz/scripts/merge.py
[ -f $MERGE_PY.bak ] || cp $MERGE_PY $MERGE_PY.bak
sed -i "s/^    cpus = [0-9]*$/    cpus = ${CPUS}/" $MERGE_PY
grep -n "    cpus = " $MERGE_PY

mkdir -p merge_final
cat > merge_final/run.sh << EOF
#!/bin/bash
cd ${CONFIG_DIR}
time apptainer exec -B /cvmfs -B /grid_mnt \\
    --env SPRITZ_PATH=${G} --env PYTHONPATH=${G}/src:${G} \\
    ${SIF} \\
    ${PY} -c "import sys; sys.argv=['spritz-merge','--merge']; from spritz.scripts.merge import main; main()"
EOF
chmod +x merge_final/run.sh

cat > merge_final/submit.jdl << EOF
universe = vanilla
executable = ${CONFIG_DIR}/merge_final/run.sh
should_transfer_files = NO
output = ${CONFIG_DIR}/merge_final/out.txt
error  = ${CONFIG_DIR}/merge_final/err.txt
log    = ${CONFIG_DIR}/merge_final/log.txt
request_memory = ${MEM}
request_cpus = ${CPUS}
T3Queue = long
WNTag   = el9
include : /opt/exp_soft/cms/t3/t3queue |
queue 1
EOF

echo "Wrote merge_final/run.sh and merge_final/submit.jdl (memory ${MEM} MB, ${CPUS} cpus, long queue)"
condor_submit merge_final/submit.jdl
